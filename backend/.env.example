# Backend environment template — copy to backend/.env and fill in real values:
#   cp .env.example .env
# The app reads this file from its working directory (backend/).

# --- required (startup fails if any of these is missing) ----------------
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=attendance_tracker
ENCRYPTION_KEY=change-me           # reserved/unused — any non-empty value
JWT_SECRET_KEY=change-me           # generate: openssl rand -hex 32
OAUTH_ALGORITHM=HS256

# --- browser origins allowed to call the API ----------------------------
CORS_ORIGINS=http://localhost:5173

# --- scraping -----------------------------------------------------------
# Live Chromium scrapes allowed at once.
#   0 (default) = AUTO: at startup the app runs one test scrape, measures
#                 its real RAM cost, and divides the box's free memory by it.
#                 Re-measures on every restart; falls back to 1 on failure.
#   > 0         = MANUAL: use exactly this number, no probing happens.
SCRAPE_CONCURRENCY=0
# Test account used by the auto probe above. It makes no DB writes and
# consumes none of the daily quota. Leave empty to disable auto probing.
SCRAPE_PROBE_USN=
SCRAPE_PROBE_PASSWORD=
# RAM reserved for Postgres + Python + OS before dividing up the rest,
# and the highest slot count auto mode may ever pick.
SCRAPE_SAFETY_MB=200
SCRAPE_MAX_SLOTS=4

# --- quotas / donation goal (these ARE the defaults) --------------------
FREE_REQUESTS_PER_DAY=4
SUPPORTER_REQUESTS_PER_DAY=6
DONATION_GOAL=500

# --- optional ------------------------------------------------------------
# Where uploaded payment screenshots are stored
# (default: backend/uploads/donations)
# DONATIONS_UPLOAD_DIR=
