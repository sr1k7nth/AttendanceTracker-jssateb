# Backend environment template — copy to backend/.env and fill in real values:
#   cp .env.example .env
# The app reads this file from its working directory (backend/).

# --- required (startup fails if any of these is missing) ----------------
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=attendance_tracker
ENCRYPTION_KEY=change-me           # reserved/unused — any non-empty value
JWT_SECRET_KEY=change-me           # generate: openssl rand -hex 32
OAUTH_ALGORITHM=HS256

# --- browser origins allowed to call the API ----------------------------
CORS_ORIGINS=http://localhost:5173

# --- donation goal (this IS the default) --------------------------------
DONATION_GOAL=500

# --- login rate limits (all values are defaults; override per env) ------
# Minutes between two scrapes of the same USN; inside the window the login
# route answers 429 "recently_scraped" and the frontend serves cached data
SCRAPE_COOLDOWN_MINUTES=5
# Portal scrapes allowed per USN per sliding window (successes only)
DAILY_SCRAPE_LIMIT=20
DAILY_SCRAPE_WINDOW_HOURS=24
# Failed logins allowed per USN per sliding window before a 429
FAILURE_LIMIT=5
FAILURE_WINDOW_MINUTES=15

# --- optional ------------------------------------------------------------
# Portal USN the admin gate accepts. Leave empty = admin routes answer 503
# "not configured". Fill in on the server; never commit the real value.
# ADMIN_USN=

# Where uploaded payment screenshots are stored
# (default: backend/uploads/donations)
# DONATIONS_UPLOAD_DIR=

# Where feedback screenshots are stored
# (default: backend/uploads/feedback)
# FEEDBACK_UPLOAD_DIR=
